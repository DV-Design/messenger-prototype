# Copy to infra/.env (git ignored). Base signaling has no public STUN/TURN dependency.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STUN_URLS=
TURN_URLS=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=600
# To enable authenticated local TURN: generate with `openssl rand -hex 32`, set
# TURN_SHARED_SECRET above, TURN_URLS=turn:127.0.0.1:3478?transport=udp, then --profile turn.
TURN_EXTERNAL_IP=127.0.0.1
# Only for loopback-only local WebRTC testing; leave false on real deployments.
TURN_ALLOW_LOOPBACK=false

# Optional public FCM/authenticated ICE configuration is deliberately separate:
# infra/public/services.env.example -> infra/.env.public-services (ignored).
# Public compose always sets REQUIRE_ICE_AUTH=1; the local lab keeps its default.
# See infra/public/SERVICES.md. No private file is required by the disabled default.
