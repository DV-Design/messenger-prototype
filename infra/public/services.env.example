# Copy to infra/.env.public-services (ignored); do not commit real credentials.
# Registration uses a unique username/device key. No SMS configuration is needed.
# Base preview with all lines empty still starts with FCM and TURN disabled.
# Used ONLY when explicitly selecting compose.firebase.example.yaml.
# External service-account path readable by the container's node UID; never put admin JSON in APK/repo.
FIREBASE_ADMIN_CREDENTIALS_FILE=
# Advertise TURN only after provisioning and forced-relay validation.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=600
# Email registration and recovery. Set all five together or none; partial configuration fails at startup.
# Keep EMAIL_HASH_SECRET stable and backed up: without it no bound address can be found again.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_HASH_SECRET=
# Set to 1 only after SMTP and the client that collects an address are live.
EMAIL_REQUIRED=
# All-account letters per hour. Keep it within the mail provider's allowance: the free tier is daily.
EMAIL_GLOBAL_PER_HOUR=200
