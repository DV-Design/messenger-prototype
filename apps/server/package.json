{
  "name": "@messenger/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --external:ws --external:firebase-admin/* --outfile=dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@messenger/core": "*",
    "ws": "^8.18.3",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "vitest": "^4.1.12"
  }
}
