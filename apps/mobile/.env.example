# Default public coordination endpoint; the /messenger prefix is preserved.
EXPO_PUBLIC_SIGNALING_URL=https://lienad.ru/messenger
# Local LAN tests only: EXPO_PUBLIC_ALLOW_LOCAL_HTTP=1 when bundling.
# Also set MESSENGER_ALLOW_LOCAL_HTTP=1 during native:prebuild to permit HTTP
# in the native network security policy. Public endpoints must use HTTPS.
# Android client Firebase config only; keep the external file outside this repo.
# Set the same path for native:prebuild AND Expo JS export/native build.
# MESSENGER_GOOGLE_SERVICES_FILE=/absolute/private/path/google-services.json
# Never put Firebase Admin credentials or SMS.ru API keys in mobile env/config.
