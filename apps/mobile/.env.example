# On a real device, use the development machine LAN address and HOST=0.0.0.0
# on the signaling server. Production servers must use HTTPS.
EXPO_PUBLIC_SIGNALING_URL=http://192.168.1.10:8787
# Set MESSENGER_ALLOW_LOCAL_HTTP=1 for native:prebuild/build in your shell
# only if testing HTTP on the private LAN. Release deployments use HTTPS.
