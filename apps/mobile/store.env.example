# Copy to .env.store (gitignored) and source it before a store build.
LASTCALL_DISTRIBUTION=store
# Confirmed production IDs; override only before the first store upload.
LASTCALL_ANDROID_PACKAGE=ru.lastcall.app
LASTCALL_IOS_BUNDLE_ID=ru.lastcall.app
# Values live in ~/.config/lastcall/keystores/lastcall-upload.properties:
# LASTCALL_RELEASE_KEYSTORE=...
# LASTCALL_KEYSTORE_PASSWORD=...
# LASTCALL_KEY_ALIAS=lastcall-upload
# LASTCALL_KEY_PASSWORD=...
