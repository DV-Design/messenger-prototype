+  private fun observeRecordingLifecycle() {
+    removeRecordingLifecycleObserver()
+    // The app may already be stopped before the async Start event arrives; in
+    // that case registering an observer will not replay ON_STOP, so close now.
+    if (!currentActivity.lifecycle.currentState.isAtLeast(Lifecycle.State.STARTED)) {
+      stopRecording()
+      return
+    }
+    val observer = object : LifecycleEventObserver {
+      override fun onStateChanged(source: LifecycleOwner, event: Lifecycle.Event) {
+        if (event == Lifecycle.Event.ON_STOP) {
+          stopRecording()
+        }
+      }
+    }
+    recordingLifecycleObserver = observer
+    currentActivity.lifecycle.addObserver(observer)
+  }
+
+  private fun removeRecordingLifecycleObserver() {
+    recordingLifecycleObserver?.let { currentActivity.lifecycle.removeObserver(it) }
+    recordingLifecycleObserver = null
+  }
+
