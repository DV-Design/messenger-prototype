{
  "name": "lastcall",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "dev:server": "npm run dev -w @messenger/server",
    "dev:probe": "npm run dev -w @messenger/probe",
    "dev:mobile": "npm run start -w @messenger/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
